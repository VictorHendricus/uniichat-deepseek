# Default provider in Config.ts is DeepSeek.
DEEPSEEK_API_KEY=

# To use Anthropic instead, set its key and uncomment these settings.
# ANTHROPIC_API_KEY=
# UNII_VENDORS=claude-api
# UNII_PICK=claude-api:sonnet-5.5:medium:slow
# UNII_COMPACTOR=claude-api:haiku-5.5:high:slow

# To use OpenAI instead, set its key and uncomment these settings.
# OPENAI_API_KEY=
# UNII_VENDORS=openai-api
# UNII_PICK=openai-api:gpt-6.1-sol:medium:slow
# UNII_COMPACTOR=openai-api:gpt-6-luna:high:slow

# Optional: email sign-in links. Without this, the link is printed in the server output.
# RESEND_API_KEY=
